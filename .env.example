# ==============================================================================
# Django Core Settings
# ==============================================================================
SECRET_KEY=your-cryptographically-strong-50-character-secret-key-here
DEBUG=True

# In production on Render, set ALLOWED_HOSTS to your Render backend domain,
# any custom domains, and Vercel frontend domain if forwarded:
# ALLOWED_HOSTS=.onrender.com,your-render-backend.onrender.com,your-app.vercel.app,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Local Development (individual PostgreSQL variables)
DB_NAME=invoiceflow
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Production (Supabase PostgreSQL via Session Pooler)
# IMPORTANT FOR RENDER: Render free tier uses outbound IPv4. Supabase direct connections
# (db.[ref].supabase.co) use IPv6 and will fail. Always use the Supabase Session Pooler
# (aws-0-[region].pooler.supabase.com on port 5432 or 6543) with sslmode=require.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ==============================================================================
# CSRF & Security Settings
# ==============================================================================
# Comma-separated list of origins trusted for CSRF (add your Vercel frontend domain in production):
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://your-render-backend.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production Security Flags (automatically enabled when DEBUG=False, can be overridden if needed)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
